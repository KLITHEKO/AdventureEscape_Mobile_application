<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA - Screen 5: The Calculate Fee Page
    Features:
    1. Top App Bar
    2. Discount-Tier Progress Bar Card (shows how many bookings unlock the next discount)
    3. List of the customer's selected packages/activities in cards (name, quantity stepper, price, line total)
    4. Quotation Summary Card (subtotal, discount, conservation levy, total)
    5. "Proceed to Booking" primary action button
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bushveld_background">

    <!-- ================= TOP APP BAR ================= -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_calculate"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bushveld_surface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/calc_title"
        app:titleTextColor="@color/bushveld_text_primary" />

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_calculate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layout_calc_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_calculate">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================= DISCOUNT-TIER PROGRESS BAR CARD ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_discount_tier"
                style="@style/Widget.AdventureEscape.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bushveld_surface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/calc_discount_tier_title"
                            android:src="@drawable/ic_star" />

                        <TextView
                            android:id="@+id/tv_discount_tier_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/calc_discount_tier_title"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Active discount badge -->
                        <TextView
                            android:id="@+id/tv_discount_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/bushveld_secondary_container"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            tools:text="10% Applied"
                            android:textColor="@color/bushveld_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Explanatory discount text -->
                    <TextView
                        android:id="@+id/tv_discount_tier_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/calc_discount_tier_subtitle"
                        android:textColor="@color/bushveld_text_secondary"
                        android:textSize="13sp" />

                    <!-- Progress Bar showing bookings unlocking next discount -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_discount_tier"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:max="5"
                        android:progress="3"
                        app:indicatorColor="@color/bushveld_primary"
                        app:trackColor="@color/bushveld_surface_variant"
                        app:trackCornerRadius="5dp" />

                    <!-- Progress Status Labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_progress_current_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="3 / 5 bookings"
                            android:textColor="@color/bushveld_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_progress_target_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2 more for 20% tier!"
                            android:textColor="@color/bushveld_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SELECTED ACTIVITIES HEADER ================= -->
            <TextView
                android:id="@+id/tv_selected_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/calc_selected_heading"
                android:textColor="@color/bushveld_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_discount_tier" />

            <!-- Empty cart reminder indicator (shown if cart is empty) -->
            <TextView
                android:id="@+id/tv_empty_cart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/calc_empty_hint"
                android:textColor="@color/bushveld_text_muted"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_selected_header" />

            <!-- List of Selected Packages / Activities Cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_selected_items"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_selected_header"
                tools:itemCount="2"
                tools:listitem="@layout/item_calculate_card" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_selected_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tv_empty_cart,rv_selected_items" />

            <!-- ================= QUOTATION SUMMARY CARD ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quotation_summary"
                style="@style/Widget.AdventureEscape.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bushveld_surface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrier_selected_items">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_summary_heading"
                        android:textColor="@color/bushveld_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Subtotal Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calc_subtotal_label"
                            android:textColor="@color/bushveld_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_summary_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="R 3,850.00"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Discount Row -->
                    <LinearLayout
                        android:id="@+id/layout_discount_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_summary_discount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calc_discount_label"
                            android:textColor="@color/bushveld_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_summary_discount_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="- R 385.00"
                            android:textColor="@color/bushveld_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/bushveld_surface_variant" />

                    <!-- Estimated Total Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calc_total_label"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_summary_grand_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="R 3,615.00"
                            android:textColor="@color/bushveld_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ================= PROCEED TO BOOKING BUTTON ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_calc_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bushveld_surface"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proceed_booking"
            style="@style/Widget.AdventureEscape.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/calc_btn_proceed"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
