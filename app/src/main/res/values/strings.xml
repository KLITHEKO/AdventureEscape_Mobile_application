    <string name="about_title">About Us</string>
    <string name="cd_team_photo">Adventure Escape SA guides with a group outdoors</string>
    <string name="about_team_caption">Founder Liam Daniels and the Adventure Escape SA guide team</string>
    <string name="about_story_heading">Our Story</string>
    <string name="about_story_p1">Adventure Escape SA is an initiative by Liam Daniels, who has always had a passion for outdoor adventure and eco-tourism. He noticed that families, tourists, schools and corporate groups struggle to find one place where they can compare and book exciting outdoor activities.</string>
    <string name="about_story_p2">Established in 2024, we operate throughout the Western Cape and bring together a variety of professionally guided outdoor experiences for visitors of all ages and experience levels.</string>
    <string name="about_mission_heading">What We Stand For</string>
    <string name="about_mission_adventure_title">Teamwork</string>
    <string name="about_mission_adventure_desc">Activities that bring families, classmates and colleagues together to work as a team.</string>
    <string name="about_mission_sustain_title">Fitness</string>
    <string name="about_mission_sustain_desc">Hiking, paddling and climbing that keep you active and build confidence.</string>
    <string name="about_mission_community_title">Love of Nature</string>
    <string name="about_mission_community_desc">Experiences that show off the beauty of the Western Cape and encourage people to protect it.</string>

