<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA - Screen 6: The Contact Us Page
    Features:
    1. Top App Bar with back navigation
    2. Contact Form with Full Name, Email Address, and Message fields, and a "Send Message" button
    3. "Get in Touch" section with phone, email, and operating base details
    4. Map placeholder card illustrating the Western Cape operating area
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bushveld_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp">

        <!-- ================= TOP APP BAR ================= -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_contact"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bushveld_surface"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/bushveld_text_primary"
            app:title="@string/contact_title"
            app:titleTextColor="@color/bushveld_text_primary" />

        <!-- ================= CONTACT FORM CARD ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_contact_form"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_contact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_form_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_form_heading"
                    android:textColor="@color/bushveld_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Field 1: Full Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/contact_name_hint"
                    app:boxStrokeColor="@color/bushveld_primary"
                    app:hintTextColor="@color/bushveld_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/bushveld_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 2: Email Address -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/contact_email_hint"
                    app:boxStrokeColor="@color/bushveld_primary"
                    app:hintTextColor="@color/bushveld_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/bushveld_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Field 3: Message -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_message"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/contact_message_hint"
                    app:boxStrokeColor="@color/bushveld_primary"
                    app:hintTextColor="@color/bushveld_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:minLines="3"
                        android:textColor="@color/bushveld_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- "Send Message" Primary Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_message"
                    style="@style/Widget.AdventureEscape.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/contact_btn_send"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_email"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= "GET IN TOUCH" DETAILS SECTION ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_contact_details"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_contact_form">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_info_heading"
                    android:textColor="@color/bushveld_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Detail 1: Phone / WhatsApp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/contact_phone_label"
                        android:src="@drawable/ic_phone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_phone_label"
                            android:textColor="@color/bushveld_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_contact_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_phone_val"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detail 2: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/contact_email_label"
                        android:src="@drawable/ic_email" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_email_label"
                            android:textColor="@color/bushveld_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_contact_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_email_val"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detail 3: Operating Base Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/contact_location_label"
                        android:src="@drawable/cape" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_location_label"
                            android:textColor="@color/bushveld_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_contact_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_location_val"
                            android:textColor="@color/bushveld_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= MAP PLACEHOLDER FOR OPERATING AREA ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_map_placeholder"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_contact_details">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="@string/contact_map_heading"
                    android:textColor="@color/bushveld_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Map Graphic Placeholder -->
                <ImageView
                    android:id="@+id/img_operating_map"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:contentDescription="@string/contact_map_heading"
                    android:scaleType="centerCrop"
                    android:src="@drawable/cape" />

                <!-- Operating Area Badge Description -->
                <TextView
                    android:id="@+id/tv_map_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bushveld_surface_variant"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="@string/contact_map_badge"
                    android:textColor="@color/bushveld_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
