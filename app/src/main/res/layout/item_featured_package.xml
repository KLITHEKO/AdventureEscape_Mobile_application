<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA - Featured Package Card Item
    Used in Home Page horizontal scroll and "You May Also Like" recommendation row.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_featured_package"
    style="@style/Widget.AdventureEscape.Card"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <!-- Package Image Placeholder -->

        <!-- Category Tag / Badge -->
        <ImageView
            android:id="@+id/img_featured"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:contentDescription="@string/home_section_featured"
            android:scaleType="centerCrop"
            android:src="@drawable/img_adventure_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_featured_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/bushveld_primary_container"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="Adventure Package"
            android:textColor="@color/bushveld_on_primary_container"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_featured" />

        <!-- Duration indicator -->
        <TextView
            android:id="@+id/tv_featured_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            tools:text="2 Days"
            android:textColor="@color/bushveld_text_muted"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_featured_category"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_featured_category" />

        <!-- Package Title -->
        <TextView
            android:id="@+id/tv_featured_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Cape Peninsula Eco Odyssey"
            android:textColor="@color/bushveld_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_featured_category" />

        <!-- Price Display -->
        <TextView
            android:id="@+id/tv_featured_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            tools:text="From R 2,850 pp"
            android:textColor="@color/bushveld_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_featured_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_featured_title" />

        <!-- View Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_featured_view"
            style="@style/Widget.AdventureEscape.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="8dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="@string/home_btn_view"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_featured_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
