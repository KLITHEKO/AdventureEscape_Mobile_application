<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA – Screen 2: About Us
    Features:
    1. A top app bar with a back button for returning to the previous screen.
    2. A card displaying a founder or team photo, with a caption underneath.
    3. A text section explaining the company’s story. 
    4. An “Our Mission” section with three cards highlighting Adventure, Sustainability, and Community.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bushveld_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- ================= TOP APP BAR ================= -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_about"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bushveld_surface"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/bushveld_text_primary"
            app:title="@string/about_title"
            app:titleTextColor="@color/bushveld_text_primary" />

        <!-- ================= TEAM / FOUNDER PHOTO PLACEHOLDER ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_team_photo"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_about">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Founder/Team Photo Placeholder Image -->
                <ImageView
                    android:id="@+id/img_team"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:contentDescription="@string/cd_team_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/team" />

                <!-- Photo Caption -->
                <TextView
                    android:id="@+id/tv_team_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bushveld_surface_variant"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/about_team_caption"
                    android:textColor="@color/bushveld_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= NARRATIVE STORY SECTION ================= -->
        <TextView
            android:id="@+id/tv_story_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/about_story_heading"
            android:textColor="@color/bushveld_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_team_photo" />

        <TextView
            android:id="@+id/tv_story_p1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/about_story_p1"
            android:textColor="@color/bushveld_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_story_heading" />

        <TextView
            android:id="@+id/tv_story_p2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/about_story_p2"
            android:textColor="@color/bushveld_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_story_p1" />

        <!-- ================= "OUR MISSION" HEADING ================= -->
        <TextView
            android:id="@+id/tv_mission_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="@string/about_mission_heading"
            android:textColor="@color/bushveld_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_story_p2" />

        <!-- CARD 1: ADVENTURE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mission_adventure"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_mission_heading">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Icon placeholder -->
                <ImageView
                    android:id="@+id/ic_mission_adv"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bushveld_primary_container"
                    android:contentDescription="@string/about_mission_adventure_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_adventure" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_mission_adventure_title"
                        android:textColor="@color/bushveld_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/about_mission_adventure_desc"
                        android:textColor="@color/bushveld_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2: SUSTAINABILITY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mission_sustainability"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_mission_adventure">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Icon placeholder -->
                <ImageView
                    android:id="@+id/ic_mission_sust"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bushveld_secondary_container"
                    android:contentDescription="@string/about_mission_sustain_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_sustainability" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_mission_sustain_title"
                        android:textColor="@color/bushveld_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/about_mission_sustain_desc"
                        android:textColor="@color/bushveld_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 3: COMMUNITY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mission_community"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_mission_sustainability">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Icon placeholder -->
                <ImageView
                    android:id="@+id/ic_mission_comm"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bushveld_accent_container"
                    android:contentDescription="@string/about_mission_community_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_community" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_mission_community_title"
                        android:textColor="@color/bushveld_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/about_mission_community_desc"
                        android:textColor="@color/bushveld_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
