<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA – Screen 1: Home Page

    Features:
    1. A top app bar displaying the Adventure Escape SA logo and app name.
    2. A hero section with an image placeholder, a short tagline introducing the company, 
    and a primary “Browse Adventures” button that takes customers to the available packages.
    3. A quick-link card titled “Our Story & Mission” that navigates to the About Us page.
    4. A horizontally scrolling “Featured Packages” section displaying adventure packages with an image, 
    price, and a “View” button to explore each package.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bushveld_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- ================= TOP APP BAR ================= -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_home"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bushveld_surface"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingEnd="16dp">

                <!-- Adventure Escape SA Emblem Logo -->
                <ImageView
                    android:id="@+id/img_app_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/img_adventure_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/bushveld_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_location"
                        android:textColor="@color/bushveld_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Eco Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/bushveld_secondary_container"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/home_badge_eco"
                    android:textColor="@color/bushveld_on_secondary_container"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- ================= HERO SECTION ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_home">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Hero Image Placeholder (Western Cape Landscape) -->
                <ImageView
                    android:id="@+id/img_hero"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:contentDescription="@string/home_hero_tagline"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_hero_cape"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Dark Gradient Scrim Overlay for contrast -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/scrim_dark"
                    app:layout_constraintBottom_toBottomOf="@id/img_hero"
                    app:layout_constraintEnd_toEndOf="@id/img_hero"
                    app:layout_constraintStart_toStartOf="@id/img_hero"
                    app:layout_constraintTop_toTopOf="@id/img_hero" />

                <!-- Tagline Badge -->
                <TextView
                    android:id="@+id/tv_hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/bushveld_primary"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/home_hero_badge"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Short Hero Tagline -->
                <TextView
                    android:id="@+id/tv_hero_tagline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_hero_tagline"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hero_badge" />

                <!-- Content Container Below Image -->
                <LinearLayout
                    android:id="@+id/layout_hero_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/img_hero">

                    <TextView
                        android:id="@+id/tv_hero_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_hero_subtitle"
                        android:textColor="@color/bushveld_text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- "Browse Adventures" Primary Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browse_adventures"
                        style="@style/Widget.AdventureEscape.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/home_btn_browse"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_nav_overview"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= ABOUT US TEASER CARD ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_about_teaser"
            style="@style/Widget.AdventureEscape.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/bushveld_surface_variant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_hero">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ic_leaf"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/cd_eco_mission"
                    android:src="@drawable/ic_sustainability"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_about_teaser_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/home_about_teaser_title"
                    android:textColor="@color/bushveld_secondary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btn_view_about"
                    app:layout_constraintStart_toEndOf="@id/ic_leaf"
                    app:layout_constraintTop_toTopOf="@id/ic_leaf" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_about_teaser_desc"
                    android:textColor="@color/bushveld_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/btn_view_about"
                    app:layout_constraintStart_toEndOf="@id/ic_leaf"
                    app:layout_constraintTop_toBottomOf="@id/tv_about_teaser_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_about"
                    style="@style/Widget.AdventureEscape.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/nav_about"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= FEATURED PACKAGES SECTION ================= -->
        <TextView
            android:id="@+id/tv_featured_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/home_section_featured"
            android:textColor="@color/bushveld_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_about_teaser" />

        <TextView
            android:id="@+id/tv_see_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/home_see_all"
            android:textColor="@color/bushveld_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_featured_heading"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_featured_heading" />

        <!-- Horizontally Scrolling Featured Packages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_featured_packages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_featured_heading"
            tools:listitem="@layout/item_featured_package" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
