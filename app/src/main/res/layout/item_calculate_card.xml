<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Adventure Escape SA - Selected Package / Activity Cart Item
    Used in Calculate Fee Page for customer's selected bookings.
    Features item title, unit price, quantity stepper (- / +), and calculated line total.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_calculate_item"
    style="@style/Widget.AdventureEscape.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Activity Title -->
        <TextView
            android:id="@+id/tv_calc_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/bushveld_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_calc_delete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Table Mountain 112m Abseil" />

        <!-- Remove Item Button -->
        <ImageButton
            android:id="@+id/btn_calc_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_remove_booking"
            android:src="@drawable/ic_delete"
            app:tint="@color/bushveld_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Unit Price -->
        <TextView
            android:id="@+id/tv_calc_unit_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bushveld_text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_calc_item_title"
            tools:text="R 1,450 per person" />

        <!-- Quantity Stepper Controls -->
        <LinearLayout
            android:id="@+id/layout_stepper"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/bushveld_surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_calc_unit_price">

            <!-- Minus Button -->
            <ImageButton
                android:id="@+id/btn_calc_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_decrease_people"
                android:src="@drawable/ic_remove" />

            <!-- Quantity Display -->
            <TextView
                android:id="@+id/tv_calc_quantity"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/bushveld_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2" />

            <!-- Plus Button -->
            <ImageButton
                android:id="@+id/btn_calc_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_increase_people"
                android:src="@drawable/ic_add" />

        </LinearLayout>

        <!-- Line Total Label & Value -->
        <LinearLayout
            android:id="@+id/layout_line_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/layout_stepper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_stepper">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calc_subtotal_label"
                android:textColor="@color/bushveld_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_calc_line_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bushveld_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="R 2,900" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
